cmd-removeextracomponents-desc = Remove todos os componentes de todas as entidades do id especificado se esse componente nao estiver em seu prototipo.
    Se nenhum id for especificado, corresponde a todas as entidades.
cmd-removeextracomponents-help= remover componentes extra / remover componentes extra <entityId>
cmd-removeextracomponents-invalid-prototype-id = Nao foi possivel encontrar prototipo de entidade com id {$id}.
cmd-removeextracomponents-success = Removidos { $count} componentes de {$entities},
cmd-removeextracomponents-success-with-id = Removidos { $count} componentes de {$entities} com id {$id}.

