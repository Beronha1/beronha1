command-description-xenoartifact-list =
    Liste todos os EntityUids dos artefatos gerados.
command-description-xenoartifact-printmatrix =
    Imprime uma matriz que exibe todas as arestas entre os nós.
command-description-xenoartifact-totalresearch =
    Obtém todos os pontos de pesquisa que podem ser extraídos do artefato atualmente.
command-description-xenoartifact-averageresearch =
    Calcula a quantidade média de pontos de pesquisa gerados pelo artefato xeno que será gerado quando totalmente ativado.
command-description-xenoartifact-unlockallnodes =
    Desbloqueia todos os nós do artefato.

command-description-xenoartifact-createnode =
    Crie um nó no artefato (novo na profundidade 0 ou anexe próximo ao existente).
command-description-xenoartifact-createnodeatdepth =
    Adicione um novo nó ao artefato fornecido.
command-description-xenoartifact-spawnartwithnode =
    Gera um novo artefato xeno com nó único com o gatilho e efeito fornecidos.
command-description-xenoartifact-unlocknode =
    Marca um nó como desbloqueado.
command-description-xenoartifact-removenode =
    Remove um nó de um artefato xeno.
command-description-xenoartifact-addedge =
    Adiciona uma borda entre dois nós de um artefato xeno.

command-spawnartifactwithnode-spawn-artifact-item-hint =usar artefato portátil
command-spawnartifactwithnode-spawn-artifact-structure-hint =use artefato estacionário semelhante a uma estrutura
command-spawnartifactwithnode-spawn-artifact-type-hint = <ID do protótipo da entidade do artefato>

command-xenoartifact-common-node-hint =profundidade {$depth} nó {$nodeId} gatilho {$nodeDetail}

