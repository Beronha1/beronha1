heretic-roundend-name = herético

# Trauma
roundend-prepend-heretic-ascension-success = {$name} [color=green]ascendeu![/color]
roundend-prepend-heretic-ascension-fail = {$name} [color=red]falhou em ascender![/color]
roundend-prepend-heretic-ascension-fail-owls = {$name} [color=yellow]abandonou a Ascensão![/color]
roundend-prepend-heretic-knowledge-named = [color=white]{$name}[/color] researched the most knowledges, having [color=purple]{$number}[/color] total.

heretic-gamemode-title = Hereges
heretic-gamemode-description =
    Anomalia dimensional detectada dentro da estação. Não há dados adicionais.

heretic-role-greeting-fluff =
    Outro dia de trabalho sem sentido. Você sente um brilho ao seu redor, enquanto uma sensação de algo estranho no ar se manifesta. Você olha para dentro de si e descobre algo que vai mudar sua vida.

    Os Portais do Mansus se abrem para sua mente.

heretic-role-greeting =
    Você é o Herético!

    Leia mais sobre seu papel no guia de entrada.

heretic-role-greeting-short =
    Você é o Herético!
    Para aprender o Ritual Final e Ascender, você deve cumprir suas tarefas.

## ghoul
heretic-ghoul-greeting =
    Você foi convocado a este mundo por {CAPITALIZE(THE($ent))}!
    Você deve ajudá-lo em sua jornada de ascensão e protegê-lo a todo custo.
    Você pode seguir outros hereges se seu mestre estiver além da ressurreição.
heretic-ghoul-greeting-noname =
    Você foi convocado a este mundo por forças eldritch.
    Obedeça as ordens de seus mestres aconteça o que acontecer.
heretic-ghoul-briefing-start =
    Você foi convocado a este mundo por {CAPITALIZE(THE($ent))}!
heretic-ghoul-briefing-start-noname =
    Você foi convocado a este mundo por forças eldritch.
heretic-ghoul-briefing-end =
    Obedeça as ordens de seus mestres aconteça o que acontecer.

    Use a tecla +m no chat para acessar o vínculo do mansus.

