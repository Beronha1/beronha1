set-game-preset-command-description = Define o preset de jogo para o número especificado de rodadas futuras. Também pode exibir o título e descrição de outro preset no lobby para enganar os jogadores.
set-game-preset-command-help-text = setgamepreset <id> [número de rodadas, padrão 1] [preset falso]
set-game-preset-command-hint-1 = <id>
set-game-preset-command-hint-2 = [número de rodadas]
set-game-preset-command-hint-3 = [preset falso]

set-game-preset-optional-argument-not-integer = Se o argumento 2 for fornecido, ele deve ser um número.
set-game-preset-preset-error = Não foi possível encontrar o preset de jogo "{$preset}"
set-game-preset-decoy-error = Se o argumento 3 for fornecido, ele deve ser um preset válido. Não foi possível encontrar o preset de jogo "{$preset}"

#set-game-preset-preset-set= Defina a predefinição do jogo como "{$preset}"
set-game-preset-preset-set-finite = Define o preset de jogo para "{$preset}" pelas próximas {$rounds} rodadas.
set-game-preset-preset-set-finite-with-decoy = Define o preset de jogo para "{$preset}" pelas próximas {$rounds} rodadas, exibindo {$decoy} no lobby.
