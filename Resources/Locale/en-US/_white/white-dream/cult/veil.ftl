# Tear the veil + blood rift - ported from funky-station (PR #630 / #1922)

# Tearing the veil
cult-veil-ritual-started = The chant has begun. { $required } of us must hold the runes until the veil gives.
cult-veil-ritual-already-in-progress = The chant is already underway elsewhere.
cult-veil-ritual-already-completed = The veil is already torn. Find the rift.
cult-veil-ritual-not-enough-cultists = Not enough of us stand upon the runes. { $current } of { $required }.
cult-veil-ritual-broken = The chant falters!
cult-veil-ritual-failed = The chant broke. Only { $current } of { $required } held the runes.
cult-veil-ritual-success = The veil is torn. Nar'Sie stirs. Wait for the rift to bleed through.
cult-veil-torn = REALITY IS BLEEDING. THE VEIL HAS BEEN TORN.

# The rift
cult-rift-spawned = The rift has opened { $location }. Gather upon its runes.

# Final summoning
cult-final-ritual-started = The final chant begins. Whoever speaks the long words will be taken.
cult-final-ritual-already = The final chant is already underway.
cult-final-ritual-not-enough = Not enough of us stand upon the runes. { $current } of { $required }.
cult-final-ritual-response = Nar'Sie!
cult-final-ritual-broken = The chant collapses!
cult-final-ritual-failed = The final chant broke. Only { $current } of { $required } held the runes.
cult-final-ritual-sacrifice = { $done ->
        [1] The first offering is taken. She begins to enter our reality.
        [2] The second offering is taken. The Geometer pries open the veil.
       *[other] The final offering is taken. She. Is. Here.
    }

# Study the veil, once it has been torn
cult-status-rift-pending = The veil is torn. The rift is still forcing its way through.
cult-status-rift-open = The rift bleeds { $location }. Stand upon its runes and chant.
