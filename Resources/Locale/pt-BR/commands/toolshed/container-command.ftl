command-description-container-contents =
    Obtém todas as entidades dentro de um contêiner em uma entidade por meio do ID do contêiner.
command-description-container-get =
    Obtém um contêiner em uma entidade por meio do ID do contêiner.
command-description-container-insert =
    Coloca uma entidade dentro do contêiner canalizado.
command-description-container-insertmultiple =
    Coloque várias entidades dentro do contêiner canalizado.
command-description-container-list =
    Obtém os IDs de todos os contêineres de uma entidade.
command-description-container-getall =
    Obtém todos os contêineres de uma entidade.
command-description-container-id =
    Obtém o ID da string dos contêineres canalizados.

