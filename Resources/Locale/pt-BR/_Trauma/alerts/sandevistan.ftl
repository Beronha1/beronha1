alerts-sandevistan-load-name = [color=cyan]Carga de Ciberware[/color]
alerts-sandevistan-load-desc = Nível de carga atual do seu implante sandevistan. Valores maiores significam maior sobrecarga no seu corpo.
    At [color=yellow]{ SANDE_THRESHOLD("warning") }[/color] você começará a receber avisos.
    At [color=orange]{ SANDE_THRESHOLD("shaking") }[/color] você começará a tremer descontroladamente.
    At [color=red]{ SANDE_THRESHOLD("damage") }[/color] você começará a receber dano físico.
    At [color=darkred]{ SANDE_THRESHOLD("disable") }[/color] o implante será desligado à força.

