# Shown when damage occurs
turbine-spark = O {$owner} começa a brilhar!
turbine-spark-stop = O {$owner} para de acender.
turbine-smoke = O {$owner} começa a soltar fumaça!
turbine-smoke-stop = O {$owner} para de fumar.

# Shown during repairs
