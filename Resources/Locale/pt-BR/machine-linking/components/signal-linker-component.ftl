signal-linker-component-saved =Link salvo com sucesso para {$machine}!
signal-linker-component-linked-port = Vinculado {$machine1}:{$port1} a {$machine2}:{$port2} com sucesso!
signal-linker-component-unlinked-port = {$machine1}:{$port1} desvinculado com sucesso de {$machine2}:{$port2}!
signal-linker-component-connection-refused= {$machine} recusou a conexão!
signal-linker-component-max-connections-receiver = Máximo de conexões alcançadas no receptor!
signal-linker-component-max-connections-transmitter = Máximo de conexões alcançadas no transmissor!

signal-linker-component-type-mismatch = O tipo da porta não corresponde ao tipo da porta salva!

signal-linker-component-out-of-range = A conexão está fora de alcance!

# Verbs
signal-linking-verb-text-link-default = Vincular portas padrão
signal-linking-verb-success = Conectados todos os links {$machine} padrão.
signal-linking-verb-fail = Falha ao conectar todos os links {$machine} padrão.
signal-linking-verb-disabled-no-transmitter = Primeiro interaja com um transmissor e depois vincule as portas padrão.
signal-linking-verb-disabled-no-receiver = Primeiro interaja com um receptor e depois vincule as portas padrão.
