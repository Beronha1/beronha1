cmd-announce-desc = Envia um anuncio dentro do jogo com cor e som personalizados.
cmd-announce-help = {$command} <mensagem> [remetente] [color] [som] - Envia anuncio. Remetente padrao é Central Command, cor Gold, som announce.ogg. A cor deve seguir o formato #RRGGBB.

# The default sender for the announcement
cmd-announce-sender = Comando Central

# Completion hints
cmd-announce-arg-message = <mensagem>
cmd-announce-arg-sender = [remetente]
cmd-announce-arg-color = [color]
cmd-announce-arg-sound = [som]

