miner-weapon-selector-pka-name =Acelerador protocinético
miner-weapon-selector-pka-description =
    Acelerador clássico de parafuso de curto alcance que lida
    dano constante com alta precisão.
miner-weapon-selector-repeater-name = Repetidor protocinético
miner-weapon-selector-repeater-description =
    Uma arma de explosão de médio alcance que dispara 3 balas
    seguidas, causando grandes quantidades de dano.
miner-weapon-selector-pistols-name = Pistolas protocinéticas
miner-weapon-selector-pistols-description =
    2 pistolas que você pode empunhar duas vezes para se parecer com o meio-oeste.
    Causa uma quantidade razoável de dano em troca de um bom alcance.

miner-weapon-selector-crusher-name = Machado Triturador
miner-weapon-selector-crusher-description =
    Arma corpo a corpo clássica para cortar inimigos em lavaland.
miner-weapon-selector-glaive-name = Glaive Trituradora
miner-weapon-selector-glaive-description =
    Uma arma perfurante que possui alto alcance e velocidade de ataque
    em troca de danos menores. Ótimo se você quiser
    atacar os inimigos em segurança.
miner-weapon-selector-hammer-name = Martelo Triturador
miner-weapon-selector-hammer-description =
    Uma arma pesada e contundente que causa muito dano
    em golpes lentos e poderosos. Pode minerar rochas de forma ineficiente.

