cmd-panicbunker-desc = Alterna o panic bunker, que habilita restricoes mais rigidas sobre quem pode entrar no servidor.
cmd-panicbunker-help = Uso: panicbunker
panicbunker-command-enabled = Panic bunker foi habilitado.
panicbunker-command-disabled = Panic bunker foi desabilitado.

cmd-panicbunker_disable_with_admins-desc = Alterna se o panic bunker sera desativado quando um admin conecta.
cmd-panicbunker_disable_with_admins-help = Uso: panicbunker_disable_with_admins
panicbunker-command-disable-with-admins-enabled = O panic bunker sera desativado automaticamente com admins online.
panicbunker-command-disable-with-admins-disabled = O panic bunker nao sera desativado automaticamente com admins online.

cmd-panicbunker_enable_without_admins-desc = Alterna se o panic bunker sera ativado quando o ultimo admin sair.
cmd-panicbunker_enable_without_admins-help = Uso: panicbunker_enable_without_admins
panicbunker-command-enable-without-admins-enabled = O panic bunker sera ativado automaticamente sem admins online.
panicbunker-command-enable-without-admins-disabled = O panic bunker nao sera ativado automaticamente sem admins online.

cmd-panicbunker_count_deadminned_admins-desc = Alterna se contas deadmins devem ser contadas ao ativar e desativar panic bunker automaticamente.
cmd-panicbunker_count_deadminned_admins-help = Uso: panicbunker_count_deadminned_admins
panicbunker-command-count-deadminned-admins-enabled = O panic bunker passara a contar deadmins ao ativar e desativar automaticamente.
panicbunker-command-count-deadminned-admins-disabled = O panic bunker nao passara a contar deadmins ao ativar e desativar automaticamente.

cmd-panicbunker_show_reason-desc = Alterna se os clientes conectados devem ver a razao de bloqueio pelo panic bunker.
cmd-panicbunker_show_reason-help = Uso: panicbunker_show_reason
panicbunker-command-show-reason-enabled = O panic bunker agora mostrara aos usuarios uma razao de bloqueio.
panicbunker-command-show-reason-disabled = O panic bunker nao mostrara mais aos usuarios a razao de bloqueio.

cmd-panicbunker_min_account_age-desc = Consulta ou define a idade minima da conta em minutos para permitir conexao com panic bunker ativo.
cmd-panicbunker_min_account_age-help = Uso: panicbunker_min_account_age <minutos>
panicbunker-command-min-account-age-is = A idade minima da conta para panic bunker e {$minutes} minutos.
panicbunker-command-min-account-age-set = Idade minima da conta para panic bunker definida em {$minutes} minutos.

cmd-panicbunker_min_overall_minutes-desc = Consulta ou define o tempo total minimo de jogo em minutos para permitir conexao com panic bunker ativo.
cmd-panicbunker_min_overall_minutes-help = Uso: panicbunker_min_overall_minutes <minutos>
panicbunker-command-min-overall-minutes-is = O tempo total minimo para panic bunker e {$minutes} minutos.
panicbunker-command-min-overall-minutes-set = Tempo total minimo para panic bunker definido em {$minutes} minutos.
