command-description-inventory-getflags =
    Obtém todas as entidades em slots na entidade de inventário canalizado que corresponde a um determinado sinalizador de slot.
command-description-inventory-getnamed =
    Obtém todas as entidades em slots na entidade de inventário canalizado que corresponde a um determinado nome de slot.
command-description-inventory-forceput =
    Coloca uma determinada entidade na primeira entidade canalizada que possui um slot correspondente ao sinalizador fornecido, excluindo qualquer item anteriormente nesse slot.
command-description-inventory-forcespawn =
    Gera um determinado protótipo na primeira entidade canalizada que possui um slot correspondente ao sinalizador fornecido, excluindo qualquer item anteriormente nesse slot.
command-description-inventory-put =
    Coloca uma determinada entidade na primeira entidade canalizada que possui um slot correspondente ao sinalizador fornecido, desequipando qualquer item anteriormente nesse slot.
command-description-inventory-spawn =
    Gera um determinado protótipo na primeira entidade canalizada que possui um slot correspondente à bandeira fornecida, desequipando qualquer item anteriormente nesse slot.
command-description-inventory-tryput =
    Tenta colocar uma determinada entidade na primeira entidade canalizada que possui um slot correspondente ao sinalizador fornecido, falhando se algum item estiver atualmente nesse slot.
command-description-inventory-tryspawn =
    Tenta gerar um determinado protótipo na primeira entidade canalizada que possui um slot correspondente ao sinalizador fornecido, falhando se algum item estiver atualmente nesse slot.
command-description-inventory-ensure =
    Coloca uma determinada entidade na primeira entidade canalizada que possui um slot correspondente ao sinalizador fornecido, se não existir nenhum, passando pelo UID de tudo o que estiver no slot no final.
command-description-inventory-ensurespawn =
    Gera um determinado protótipo na primeira entidade canalizada que possui um slot correspondente ao sinalizador fornecido, se não existir nenhum, passando pelo UID de tudo o que estiver no slot no final.
command-description-inventory-contents =
    Obtém as entidades nos slots de inventário das entidades canalizadas e as repassa.

