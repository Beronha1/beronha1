objective-condition-kill-everyone-else-title = MATAR TODOS OS OUTROS

objective-condition-hug-and-tickle-title = ABRAÇE TODOS
objective-condition-hug-and-tickle-desc = A tripulação adora tanto que espalha ketchup por toda parte! Ainda bem que você gosta de ketchup! Yupeee!

objective-kill-wizard-desc =
    Quem teve coragem de te invocar tem que pagar o preço final.
    O sangue arcano deles chama por você, encontre, caçe, e envie suas almas gritando para o vazio.
    A magia deles termina aqui.

objective-kill-everyone-desc =
    Este plano fede a carne mortal.
    Pinte estes corredores de carmim, deixe cada batida de coração ser silenciada.
    Deixe nada além de ecos de terror e rios de sangue.

# true fluff
objective-annihilate-janitors-title =
    Aniquile todos os Lixeiros e seus substitutos robóticos.

objective-spare-crew-title =
    Poupem alguns membros da tripulação para fazê-los sangrar antes do golpe final.

objective-hunt-for-brave-title =
    Cace os bravos que tentam caçar você primeiro.

objective-hunt-the-cowards-title =
    Cace os covardes que estão fugindo de você.

# almost fluff
objective-spread-blood =
    Espalhe sangue por {$area}.

objective-show-power-title =
    Mostre a {$targetName} o verdadeiro poder do sangue.

objective-drive-insane-title =
    Enlouqueça {$targetName} com seus sussurros demoníacos.

